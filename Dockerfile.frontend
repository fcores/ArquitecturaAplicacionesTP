# --------- ETAPA 1: Build del Frontend ----------
    FROM node:18-alpine AS build
    WORKDIR /app
    
    # Instalar deps (usa npm ci si hay lockfile, si no npm install)
    COPY package*.json ./
    RUN npm ci || npm install
    
    # Copiar código y compilar
    COPY . .
    RUN npm run build
    
    # Normalizar la salida del build en /app/webroot
    # - Si existe /app/dist (Vite) => usarlo
    # - Si existe /app/build (CRA) => usarlo
    RUN mkdir -p /app/webroot \
     && if [ -d "/app/dist" ]; then cp -r /app/dist/* /app/webroot/; \
        elif [ -d "/app/build" ]; then cp -r /app/build/* /app/webroot/; \
        else echo "No se encontró ni dist/ ni build/ tras npm run build"; exit 1; fi
    
    
    # --------- ETAPA 2: Nginx que sirve el Front y proxy a la API ----------
    FROM nginx:1.25-alpine
    
    # Config de Nginx (asegurate de tener default.conf junto al Dockerfile)
    COPY default.conf /etc/nginx/conf.d/default.conf
    
    # Copiar el build ya normalizado
    COPY --from=build /app/webroot /usr/share/nginx/html
    
    # Ajustes (no recreamos usuario/grupo; ya existen en la imagen)
    # Opcionalmente garantiza permisos de escritura donde Nginx los usa:
    RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/run || true
    
    EXPOSE 80
    USER nginx
    STOPSIGNAL SIGQUIT
    CMD ["nginx","-g","daemon off;"]