# ---------- Stage 1: Build ----------
    FROM node:18-alpine AS build
    WORKDIR /app
    
    # Dependencias
    COPY package*.json ./
    # usa ci si hay lockfile; cae a install si no
    RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund
    
    # Código
    COPY . .
    
    # Compilado del front (React/Vite)
    # Asegúrate de tener .env.production si lo necesitas (REACT_APP_API_URL=/api)
    RUN npm run build
    
    # ---------- Stage 2: Runtime (Nginx no-root) ----------
    FROM nginx:1.25-alpine AS runtime
    
    # Configuración de Nginx para SPA + proxy (ajusta tu default.conf)
    # Debe tener: listen 8080;  y (recomendado)  'pid /tmp/nginx.pid;'
    COPY default.conf /etc/nginx/conf.d/default.conf
    
    # Asegura que Nginx escriba el pid en /tmp (por si tu default.conf no lo define)
    RUN printf 'pid /tmp/nginx.pid;\n' > /etc/nginx/conf.d/zz-override-pid.conf
    
    # Archivos estáticos: soporta dist/ (Vite) o build/ (CRA)
    # Copiamos ambas rutas; la que exista pisará a la otra
    COPY --from=build /app/dist/  /usr/share/nginx/html/
    COPY --from=build /app/build/ /usr/share/nginx/html/
    
    # Directorios que Nginx necesita en runtime
    RUN mkdir -p /var/cache/nginx /var/run \
      && chown -R nginx:nginx \
           /var/cache/nginx /var/run \
           /usr/share/nginx/html /etc/nginx/conf.d
    
    # Ejecutar como usuario no-root
    USER nginx
    
    EXPOSE 8080
    CMD ["nginx", "-g", "daemon off;"]