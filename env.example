# Archivo de ejemplo de variables de entorno para TicketPardo
# Copiar como .env y ajustar según el entorno

# === CONFIGURACIÓN DEL FRONTEND ===
# Base URL para la API - usar proxy reverso en producción
REACT_APP_API_URL=/api

# Entorno de la aplicación
REACT_APP_ENVIRONMENT=development

# === NOTAS IMPORTANTES ===
# - En desarrollo local: REACT_APP_API_URL=/api (con proxy reverso)
# - En producción: REACT_APP_API_URL=/api (Nginx hace el proxy)
# - NUNCA usar http://localhost:8000 en producción
# - Las variables REACT_APP_* se "hornean" en el build
# - Si cambias la URL, hay que reconstruir la imagen Docker

# === CONFIGURACIÓN PARA DIFERENTES ENTORNOS ===
# Desarrollo local con proxy reverso:
# REACT_APP_API_URL=/api

# Producción en EC2 con Nginx proxy:
# REACT_APP_API_URL=/api

# Solo para debugging (NO usar en producción):
# REACT_APP_API_URL=http://localhost:8000
