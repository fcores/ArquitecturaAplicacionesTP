# Configuración de la aplicación TicketPardo
# Copiar este archivo como .env y ajustar los valores según el entorno

# === CONFIGURACIÓN GENERAL ===
ENVIRONMENT=development
NODE_ENV=development

# === CONFIGURACIÓN DEL BACKEND ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PYTHONPATH=/app
PYTHONUNBUFFERED=1

# === CONFIGURACIÓN DEL FRONTEND ===
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENVIRONMENT=development

# === CONFIGURACIÓN DE BASE DE DATOS (futuro) ===
# DATABASE_URL=postgresql://user:password@localhost:5432/ticketpardo
# REDIS_URL=redis://localhost:6379

# === CONFIGURACIÓN DE SEGURIDAD ===
# SECRET_KEY=your-secret-key-here
# JWT_SECRET=your-jwt-secret-here
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === CONFIGURACIÓN DE EMAIL (futuro) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# === CONFIGURACIÓN DE LOGS ===
LOG_LEVEL=info
LOG_FORMAT=json

# === CONFIGURACIÓN DE KUBERNETES/DOCKER ===
DOCKER_REGISTRY=localhost:5000
IMAGE_TAG=latest
