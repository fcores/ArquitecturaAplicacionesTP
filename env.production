# Configuración de producción para TicketPardo
# Usar en entornos de producción (EC2, Minikube)

# === CONFIGURACIÓN GENERAL ===
ENVIRONMENT=production
NODE_ENV=production

# === CONFIGURACIÓN DEL BACKEND ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PYTHONPATH=/app
PYTHONUNBUFFERED=1

# === CONFIGURACIÓN DEL FRONTEND ===
REACT_APP_API_URL=http://ticketpardo-backend-service:8000
REACT_APP_ENVIRONMENT=production

# === CONFIGURACIÓN DE SEGURIDAD ===
CORS_ORIGINS=*
SECRET_KEY=prod-secret-key-change-me
JWT_SECRET=prod-jwt-secret-change-me

# === CONFIGURACIÓN DE LOGS ===
LOG_LEVEL=warning
LOG_FORMAT=json

# === CONFIGURACIÓN DE KUBERNETES/DOCKER ===
DOCKER_REGISTRY=localhost:5000
IMAGE_TAG=latest

# === CONFIGURACIÓN DE RECURSOS ===
BACKEND_MEMORY_LIMIT=512Mi
BACKEND_CPU_LIMIT=500m
FRONTEND_MEMORY_LIMIT=256Mi
FRONTEND_CPU_LIMIT=200m
