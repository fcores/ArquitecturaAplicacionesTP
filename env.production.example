# Configuración de producción para TicketPardo
# Copia este archivo a .env.production y actualiza los valores

# Seguridad
SECRET_KEY=cambia-esta-clave-por-una-super-segura-de-al-menos-32-caracteres
DB_PASSWORD=password-muy-seguro-para-base-de-datos

# Configuración de la aplicación
NODE_ENV=production
DEBUG=false

# IP pública de tu instancia EC2 (actualizar después del despliegue)
EC2_PUBLIC_IP=tu-ec2-public-ip-aqui

# URLs de la aplicación
REACT_APP_API_URL=http://tu-ec2-public-ip-aqui:8000

# Base de datos
DATABASE_URL=postgresql://ticketpardo:password-muy-seguro-para-base-de-datos@db:5432/ticketpardo

# Configuración de CORS (agregar dominios adicionales si es necesario)
CORS_ORIGINS=http://tu-ec2-public-ip-aqui,http://tu-ec2-public-ip-aqui:3000

# Configuración de logs
LOG_LEVEL=INFO
