# Variables de entorno para PRODUCCIÓN
# Usar en entornos de producción (EC2, Kubernetes)

# === CONFIGURACIÓN DEL FRONTEND ===
# IMPORTANTE: Usar proxy reverso para evitar problemas de CORS
VITE_API_BASE=/api

# Para acceso directo a IP de EC2 (18.191.169.71)
# VITE_API_BASE=http://18.191.169.71:8000/api

REACT_APP_ENVIRONMENT=production

# === CONFIGURACIÓN DEL BACKEND ===
ENVIRONMENT=production
PYTHONPATH=/app
PYTHONUNBUFFERED=1

# === CORS (se configura automáticamente) ===
# El backend detecta la IP pública de EC2 automáticamente
# CORS_ORIGINS se configura dinámicamente

# === DOCKER/KUBERNETES ===
IMAGE_TAG=latest
DOCKER_REGISTRY=localhost:5000

# === NOTAS IMPORTANTES ===
# - REACT_APP_API_URL=/api permite que Nginx haga el proxy reverso
# - Esto evita problemas de CORS al ser "same-origin"
# - NO usar http://ip-publica:8000 (causaría CORS cross-origin)
# - Las variables REACT_APP_* requieren rebuild para cambios
